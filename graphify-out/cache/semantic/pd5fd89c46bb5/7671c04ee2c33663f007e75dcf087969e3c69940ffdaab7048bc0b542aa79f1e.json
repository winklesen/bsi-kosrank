{"nodes": [{"id": "docs_first_requirments_coding_requerment_spk_kos_condong_catur", "label": "SPK Pemilihan Kos Condong Catur (PHP/MySQL)", "file_type": "concept", "source_file": "docs/first_requirments/coding_requerment.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Web-based SPK recommending boarding houses for students around Condong Catur, Yogyakarta; modeled directly on the INFOS 2025 paper so implemented results can be validated against the paper's manual SAW calculations (Table 6)."}, {"id": "docs_first_requirments_coding_requerment_php_mysql_stack", "label": "PHP Native + MySQL Stack", "file_type": "concept", "source_file": "docs/first_requirments/coding_requerment.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_first_requirments_coding_requerment_kriteria_table", "label": "kriteria Table Schema", "file_type": "concept", "source_file": "docs/first_requirments/coding_requerment.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_first_requirments_coding_requerment_sub_kriteria_table", "label": "sub_kriteria Table Schema", "file_type": "concept", "source_file": "docs/first_requirments/coding_requerment.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_first_requirments_coding_requerment_alternatif_table", "label": "alternatif Table Schema (Kos)", "file_type": "concept", "source_file": "docs/first_requirments/coding_requerment.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_first_requirments_coding_requerment_penilaian_table", "label": "penilaian Table Schema (Evaluation Matrix)", "file_type": "concept", "source_file": "docs/first_requirments/coding_requerment.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_first_requirments_coding_requerment_saw_steps", "label": "SAW Implementation Steps (Rating -> Normalization -> Ranking)", "file_type": "rationale", "source_file": "docs/first_requirments/coding_requerment.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Four-step recipe: define criteria/weights, map raw inputs to suitability scores via sub-kriteria, normalize the matrix per attribute type (Benefit vs Cost), then rank by Vi = sum(Wj * Rij) descending; highest score wins."}, {"id": "docs_first_requirments_coding_requerment_criteria_weights", "label": "Baseline Criteria & Weights C1-C5", "file_type": "rationale", "source_file": "docs/first_requirments/coding_requerment.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Weights sum to 1.0: Harga 0.3 (Cost), Luas Kamar 0.1, Fasilitas Kamar 0.2, Fasilitas Umum 0.2 (Benefit), Jarak 0.2 (Cost); price and distance are Cost attributes because lower values are better for students."}, {"id": "docs_first_requirments_coding_requerment_subcriteria_score_mapping", "label": "Sub-Criteria Score Mapping (20-100)", "file_type": "rationale", "source_file": "docs/first_requirments/coding_requerment.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Raw user inputs (real prices, distances, facility sets) must be converted into integer scores 20/40/60/80/100 following the Table 2 ranges before SAW math can run; PHP logic must implement these buckets."}, {"id": "docs_first_requirments_coding_requerment_normalization_formula", "label": "SAW Normalization Rij (Benefit/Cost)", "file_type": "rationale", "source_file": "docs/first_requirments/coding_requerment.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Benefit: Rij = Xij / Max(Xij); Cost: Rij = Min(Xij) / Xij - puts heterogeneous criteria (rupiah, km, facility counts) on one comparable scale."}, {"id": "docs_first_requirments_coding_requerment_ranking_formula", "label": "SAW Ranking Vi = sum(Wj * Rij)", "file_type": "rationale", "source_file": "docs/first_requirments/coding_requerment.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Multiply normalized matrix by weights and sum per alternative; sort descending - highest Vi is the best recommendation."}, {"id": "docs_first_requirments_coding_requerment_admin_panel", "label": "Admin Panel UI Requirements", "file_type": "concept", "source_file": "docs/first_requirments/coding_requerment.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_first_requirments_coding_requerment_user_filter_system", "label": "User Filter System (Kampus, Radius, Harga, Fasilitas Wajib)", "file_type": "concept", "source_file": "docs/first_requirments/coding_requerment.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_first_requirments_coding_requerment_table6_test_case", "label": "Table 6 Expected Ranking (Test Oracle)", "file_type": "rationale", "source_file": "docs/first_requirments/coding_requerment.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Serves as the functional test oracle: input alternatives A01-A05, run the SAW algorithm, and assert the output exactly matches Table 6 - Residence Permai 0.8500, Griya Seturan 0.8400, Kos Candi Gebang 0.8000, Wisma Sembada 0.7733, Kos Hijau Manis 0.6800."}], "edges": [{"source": "docs_first_requirments_coding_requerment_spk_kos_condong_catur", "target": "docs_first_requirments_docs_infos_kos_saw_paper", "relation": "references", "confidenc